{
  "name": "telrobot-skills",
  "version": "2.3.0",
  "description": "用于通过 npx skills add 安装的 Telrobot Agent Skills 包，提供 telrobot:init、telrobot:task、telrobot:number 和 telrobot:crm，覆盖 CLI 环境初始化、任务管理、号码管理与 CRM 公海客户导入。",
  "private": true,
  "files": [
    "skills/"
  ],
  "scripts": {
    "test": "node --test skills/telrobot-init/scripts/setup.test.js",
    "test:setup": "node --test skills/telrobot-init/scripts/setup.test.js",
    "setup": "node skills/telrobot-init/scripts/setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "keywords": [
    "telrobot",
    "cli",
    "agent-skills",
    "task-management",
    "number-management",
    "crm-import",
    "voice-robot",
    "outbound-calls"
  ]
}
